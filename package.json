{
  "name": "clone-tabnews",
  "version": "1.0.0",
  "description": "Implementação do https://tabnews.com.br para o https://curso.dev",
  "homepage": "https://github.com/rdoois/clone-tabnews#readme",
  "bugs": {
    "url": "https://github.com/rdoois/clone-tabnews/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rdoois/clone-tabnews.git"
  },
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "npm run services:up && next dev",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watchAll"
  },
  "dependencies": {
    "next": "^16.3.1",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "jest": "^30.5.1",
    "prettier": "^3.9.6"
  }
}
